# Database
DATABASE_URL=postgresql://builder:builder@localhost:5432/builder_leads
POSTGRES_USER=builder
POSTGRES_PASSWORD=builder
POSTGRES_DB=builder_leads

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys
GEMINI_API_KEY=your-gemini-api-key
STANNP_API_KEY=your-stannp-api-key

# SMTP (for email reports)
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# EPC API (optional - basic access needs no key)
EPC_API_KEY=

# App Settings
SECRET_KEY=change-me-to-a-random-string
APP_ENV=development
DEBUG=true
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
