# ── Infrastructure ──────────────────────────────────────
DATABASE_URL=postgresql://builder:builder@localhost:5432/builder_leads
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=generate-a-random-64-char-string-here
APP_ENV=development
DEBUG=true
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Google Gemini (AI extraction + letter generation) ──
GEMINI_API_KEY=your-gemini-api-key

# ── Google Maps (Street View + static maps for PDFs) ───
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── EPC API (Energy Performance Certificate data) ──────
EPC_API_KEY=your-epc-api-key
EPC_API_EMAIL=your-email@example.com

# ── Stannp (Royal Mail letter printing & posting) ──────
STANNP_API_KEY=your-stannp-api-key

# ── Email (daily summary reports) ──────────────────────
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
